root = true

[*.{kt,kts}]
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
max_line_length = 140
# false, unlike the org default: this repository compiles with Kotlin 1.3.50 and trailing commas are a
# 1.4 feature. With them allowed, ktlint:format inserts commas the compiler then rejects with
# "Expecting a parameter declaration" - verified, then reverted. Restore the org values when Kotlin moves.
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false

ktlint_standard_multiline-expression-wrapping = disabled
